
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', sans-serif;
  color: #edf0fb;
  background: #0d101b;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --bg: #0d101b;
  --panel: #151a29;
  --panel2: #1b2133;
  --line: #293047;
  --muted: #929bb5;
  --text: #edf0fb;
  --purple: #a78bfa;
  --blue: #60a5fa;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
}

button, input, select { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 2px solid var(--purple);
  outline-offset: 3px;
}

.shell { min-height: 100vh; }

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 245px;
  padding: 25px 17px;
  display: flex;
  flex-direction: column;
  background: #111522;
  border-right: 1px solid var(--line);
  z-index: 20;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 3px 5px 29px;
}

.brandicon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 13px;
  background: #292343;
  color: var(--purple);
}

.brand b {
  display: block;
  font: 700 21px 'Space Grotesk', sans-serif;
  letter-spacing: -.7px;
}

.brand small {
  display: block;
  margin-top: 3px;
  font-size: 8px;
  letter-spacing: 1.2px;
  color: var(--muted);
}

.close { display: none; }

.navlabel, .eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.5px;
  color: var(--muted);
}

.navlabel { margin: 8px 9px 12px; }

.nav {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  padding: 12px 13px;
  margin: 3px 0;
  border: 1px solid transparent;
  border-radius: 10px;
  background: transparent;
  color: #aeb6cc;
  text-align: left;
  font-size: 13px;
}

.nav:hover { background: #1b2031; color: var(--text); }

.nav.active {
  color: #d9ccff;
  background: #28223e;
  border-color: #3d345a;
}

.sidebottom { margin-top: auto; }

.deadline {
  padding: 16px;
  border: 1px solid var(--line);
  background: #171b2b;
  border-radius: 13px;
}

.deadline small, .deadline span { display: block; color: var(--muted); }
.deadline small { font-size: 9px; letter-spacing: 1px; }
.deadline b {
  display: block;
  margin: 8px 0;
  font: 700 20px 'Space Grotesk', sans-serif;
}
.deadline span { font-size: 10px; }

.bar {
  height: 5px;
  overflow: hidden;
  margin-top: 13px;
  border-radius: 9px;
  background: #2b3043;
}

.bar i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--purple);
}

.saved {
  display: block;
  margin: 18px 4px 0;
  color: #67d9ac;
  font-size: 10px;
}

main { margin-left: 245px; min-width: 0; }

header {
  min-height: 96px;
  padding: 20px 4.2%;
  display: flex;
  align-items: center;
  gap: 15px;
  border-bottom: 1px solid var(--line);
  background: rgba(13,16,27,.92);
}

header > div:first-of-type { flex: 1; min-width: 0; }

header small {
  color: var(--muted);
  font-size: 9px;
  letter-spacing: 1px;
}

h1, h2, h3, h4, p { margin-top: 0; }

h1 {
  margin: 6px 0 0;
  font: 600 23px 'Space Grotesk', sans-serif;
  letter-spacing: -.6px;
}

.hamb { display: none; }

.actions {
  display: flex;
  align-items: center;
  gap: 9px;
}

.autosave { color: #67d9ac; font-size: 10px; }

.iconbtn {
  width: 38px;
  min-width: 38px;
  height: 38px;
  display: inline-grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--panel);
  color: #d3d8eb;
}

.iconbtn:hover { background: #242b40; }

label.iconbtn { cursor: pointer; }

.content {
  width: 100%;
  max-width: 1500px;
  margin: auto;
  padding: 27px 4.2% 50px;
}

.hero {
  min-height: 280px;
  display: grid;
  grid-template-columns: 1.3fr .7fr;
  align-items: center;
  gap: 25px;
  padding: 34px 39px;
  overflow: hidden;
  position: relative;
  border: 1px solid #373050;
  border-radius: 19px;
  background: radial-gradient(ellipse at 90% 10%, #29213f 0, transparent 42%), linear-gradient(120deg,#1a1d31,#17192a);
}

.hero h2 {
  margin: 15px 0 12px;
  font: 700 clamp(27px,3.4vw,43px)/1.12 'Space Grotesk', sans-serif;
  letter-spacing: -1.5px;
}

.hero h2 i { color: var(--purple); font-style: normal; }

.hero p, .intro p, .panel > p {
  max-width: 540px;
  color: #a3acc5;
  font-size: 12px;
  line-height: 1.8;
}

.primary, .secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 9px;
  padding: 11px 14px;
  font-weight: 600;
  font-size: 11px;
}

.primary {
  border: 1px solid #b6a0ff;
  background: #a78bfa;
  color: #171128;
}

.primary:hover { background: #c1b1ff; }

.secondary {
  background: #1c2234;
  color: var(--text);
  border: 1px solid var(--line);
}

.heroart {
  min-height: 195px;
  display: grid;
  place-items: center;
  position: relative;
}

.orbit {
  position: absolute;
  width: 180px;
  height: 180px;
  border: 1px solid #5b4a85;
  border-radius: 50%;
  transform: rotate(-28deg) scaleY(.65);
  box-shadow: 0 0 0 23px #29223b, 0 0 0 24px #42345f;
}

.core {
  z-index: 1;
  width: 115px;
  height: 125px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  border: 1px solid #67568f;
  border-radius: 24px;
  background: linear-gradient(145deg,#383050,#1a1b2e);
  color: var(--purple);
  box-shadow: 0 15px 45px #08091080;
}

.core b { color: white; font: 700 22px 'Space Grotesk', sans-serif; }
.core small { font-size: 10px; color: #b5a8dc; }

.float {
  position: absolute;
  right: 0;
  bottom: 10px;
  padding: 9px 12px;
  border: 1px solid #3b4560;
  border-radius: 9px;
  background: #1c2333;
  color: #a5e9cc;
  font-size: 10px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 13px;
  margin: 20px 0 32px;
}

.stat {
  min-width: 0;
  padding: 17px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--panel);
}

.stat > svg { color: var(--purple); }
.stat small { color: var(--muted); font-size: 9px; letter-spacing: .5px; }
.stat b { font: 700 23px 'Space Grotesk',sans-serif; overflow-wrap: anywhere; }
.stat span { color: var(--muted); font-size: 10px; }

.heading, .paneltop, .intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
}

.heading { margin-bottom: 15px; }

.heading h3, .panel h3, .intro h2, .datehead h2 {
  margin: 6px 0;
  font: 600 20px 'Space Grotesk', sans-serif;
}

.link {
  border: 0;
  background: transparent;
  color: var(--purple);
  font-size: 11px;
}

.subjects {
  display: grid;
  grid-template-columns: repeat(5,minmax(0,1fr));
  gap: 12px;
}

.subject {
  min-width: 0;
  padding: 16px 13px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--panel);
}

.subject > span { display: block; margin-bottom: 13px; }
.subject small { display: block; min-height: 29px; color: #b6bfd5; font-size: 10px; }
.subject b { display: block; margin-top: 6px; font: 700 21px 'Space Grotesk',sans-serif; }
.subject b i { color: var(--muted); font: normal 9px 'DM Sans',sans-serif; }
.subject em { display: block; margin-top: 9px; color: var(--muted); font-size: 9px; font-style: normal; }

.panels {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 15px;
  margin-top: 22px;
}

.panel {
  min-width: 0;
  padding: 21px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
}

.panel h3 { font-size: 16px; }
.panel > p { margin-bottom: 18px; font-size: 11px; }

.minirow {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 12px 0;
  border-top: 1px solid #252b3d;
}

.minirow b { font-size: 11px; font-weight: 600; }
.minirow span { color: var(--muted); font-size: 10px; line-height: 1.6; }

.datehead {
  display: flex;
  align-items: center;
  gap: 13px;
  margin-bottom: 23px;
}

.datehead > div { flex: 1; min-width: 0; }
.datehead h2 { font-size: 20px; }
.datehead p { margin: 6px 0 0; color: var(--muted); font-size: 11px; }

.dailygrid {
  display: grid;
  grid-template-columns: minmax(0,1.6fr) minmax(230px,.8fr);
  align-items: start;
  gap: 16px;
}

.paneltop { margin-bottom: 20px; }
.paneltop h3 { margin: 0 0 5px; }
.paneltop p { margin: 0; color: var(--muted); font-size: 10px; }

.pill {
  padding: 6px 9px;
  border: 1px solid #3a3458;
  border-radius: 8px;
  color: #c4b4ff;
  background: #26213a;
  font-size: 10px;
  white-space: nowrap;
}

.panel h4 {
  margin: 20px 0 10px;
  color: #a7b0c9;
  font-size: 9px;
  letter-spacing: 1.1px;
}

.check {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 13px 8px;
  margin: 5px 0;
  border: 1px solid #292f43;
  border-radius: 10px;
  background: #191e2e;
  color: var(--text);
  text-align: left;
}

.check:hover { border-color: #4b456a; }
.check.checked { background: #18282a; border-color: #285044; }
.checkcopy { flex: 1; min-width: 0; }
.checkcopy b { display: block; font-size: 11px; font-weight: 600; line-height: 1.5; }
.checkcopy small { display: block; margin-top: 4px; color: var(--muted); font-size: 9px; line-height: 1.5; }
.check em { color: #aab3ca; font-size: 9px; font-style: normal; }

.notice {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 14px;
  margin-top: 17px;
  border: 1px solid #39314e;
  border-radius: 10px;
  background: #211e31;
  color: #c9baff;
  font-size: 10px;
  line-height: 1.7;
}

.notice svg { flex-shrink: 0; margin-top: 2px; }
.notice span { color: #b9b4d0; }
.notice b { color: #e4dbff; }

.calendarTitle { margin-top: 27px !important; }
.dateinput {
  width: 100%;
  padding: 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #101522;
  color: var(--text);
}

.intro { align-items: flex-start; margin-bottom: 20px; }
.intro h2 { font-size: 25px; }
.intro p { margin: 8px 0 0; }

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin: 20px 0 13px;
  color: var(--muted);
  font-size: 10px;
}

.search {
  display: flex;
  align-items: center;
  gap: 8px;
  width: min(390px,100%);
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: var(--panel);
  color: var(--muted);
}

.search input {
  width: 100%;
  padding: 11px 0;
  border: 0;
  outline: none;
  background: transparent;
  color: var(--text);
  font-size: 11px;
}

.chapterlist { display: flex; flex-direction: column; gap: 9px; }

.chapter {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px;
  border: 1px solid var(--line);
  border-radius: 11px;
  background: var(--panel);
}

.chapter > i {
  align-self: stretch;
  width: 3px;
  min-width: 3px;
  border-radius: 4px;
}

.fields {
  display: grid;
  grid-template-columns: minmax(0,1.5fr) minmax(0,1fr) 100px;
  gap: 12px;
  flex: 1;
  min-width: 0;
}

.fields label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: var(--muted);
  font-size: 9px;
}

.fields input, .fields select {
  width: 100%;
  min-width: 0;
  padding: 10px;
  border: 1px solid #30374d;
  border-radius: 7px;
  background: #101522;
  color: var(--text);
  font-size: 11px;
}

.delete {
  width: 33px;
  height: 35px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
  border: 1px solid #4a2d3a;
  border-radius: 8px;
  background: #2b1c29;
  color: #f49ab0;
}

.delete:hover { background: #482335; }

.settings { margin-top: 20px; }
.settingsfields { grid-template-columns: repeat(4,minmax(0,1fr)); }
.muted { color: var(--muted); font-size: 11px; line-height: 1.7; }

.revisioncards {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 14px;
}

.revisioncard {
  padding: 21px;
  border: 1px solid var(--line);
  border-radius: 13px;
  background: var(--panel);
}

.revisioncard > small { color: var(--purple); font-size: 10px; }
.revisioncard h3 { margin: 11px 0; font: 600 18px 'Space Grotesk',sans-serif; }
.revisioncard ul { padding-left: 18px; margin-bottom: 0; color: #aab3c9; font-size: 11px; line-height: 2.1; }

.testrow {
  display: grid;
  grid-template-columns: 1fr;
  gap: 6px;
  padding: 13px 0;
  border-top: 1px solid #252b3d;
}

.testrow b { font-size: 11px; }
.testrow span, .testrow em { color: var(--muted); font-size: 10px; font-style: normal; }

footer {
  padding: 20px 4.2%;
  border-top: 1px solid var(--line);
  color: #707a94;
  text-align: center;
  font-size: 10px;
}

.toast {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 13px 17px;
  border: 1px solid #2c6450;
  border-radius: 10px;
  background: #17352c;
  color: #9ce5c7;
  font-size: 11px;
  box-shadow: 0 12px 35px #0005;
}

.scrim { display: none; }

@media (max-width: 1150px) {
  .sidebar { width: 215px; }
  main { margin-left: 215px; }
  .subjects { grid-template-columns: repeat(3,minmax(0,1fr)); }
  .stats { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .hero { padding: 27px; }
  .fields { grid-template-columns: minmax(0,1fr) minmax(0,1fr) 80px; }
}

@media (max-width: 800px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform .2s ease;
    width: 265px;
  }

  .sidebar.open { transform: translateX(0); }
  .close { display: grid; place-items: center; margin-left: auto; border: 0; background: transparent; color: var(--muted); }
  .scrim { display: block; position: fixed; inset: 0; z-index: 15; background: #0009; }
  main { margin-left: 0; }
  .hamb { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel); color: var(--text); }
  header { padding: 16px 4%; min-height: 80px; gap: 10px; }
  h1 { font-size: 18px; }
  header small { font-size: 8px; }
  .autosave { display: none; }
  .content { padding: 20px 4% 35px; }
  .hero { grid-template-columns: 1fr; padding: 25px; }
  .heroart { display: none; }
  .dailygrid { grid-template-columns: 1fr; }
  .datehead { flex-wrap: wrap; }
  .datehead > div { flex-basis: 55%; }
  .datehead .secondary { margin-left: auto; }
  .fields.settingsfields { grid-template-columns: repeat(2,minmax(0,1fr)); }
}

@media (max-width: 520px) {
  .hero h2 { font-size: 32px; }
  .hero { padding: 22px; }
  .stats { gap: 8px; margin: 14px 0 25px; }
  .stat { padding: 12px; }
  .stat b { font-size: 19px; }
  .stat small { font-size: 8px; line-height: 1.5; }
  .stat span { font-size: 9px; }
  .subjects { grid-template-columns: repeat(2,minmax(0,1fr)); }
  .panels, .revisioncards { grid-template-columns: 1fr; }
  .heading { align-items: flex-start; }
  .heading h3 { font-size: 17px; }
  .link { max-width: 115px; text-align: right; line-height: 1.6; }
  .chapter { align-items: flex-start; }
  .fields { grid-template-columns: 1fr; }
  .fields label { font-size: 10px; }
  .fields input, .fields select { padding: 11px; }
  .chapter > i { min-height: 35px; }
  .delete { margin-top: 20px; }
  .toolbar { align-items: flex-start; flex-direction: column; }
  .search { width: 100%; }
  .intro { flex-direction: column; }
  .intro h2 { font-size: 23px; }
  .datehead { gap: 8px; }
  .datehead h2 { font-size: 17px; }
  .datehead .secondary { width: 100%; }
  .check { gap: 8px; padding: 12px 7px; }
  .checkcopy b { font-size: 10px; }
  .check em { font-size: 8px; }
  .panel { padding: 16px; }
  header { gap: 8px; }
  .actions { gap: 5px; }
  .iconbtn { width: 34px; min-width: 34px; height: 34px; }
}
